---
import Layout from '../layouts/Layout.astro';
import Observatory from '../components/Observatory.svelte';
import { loadContent } from '../../scripts/content.mjs';
const { profile, cases } = loadContent();
const caseLinks = cases.map(({data}) => ({ id: data.id, title: data.title }));
---
<Layout>
  <section class="hero-wrap">
    <div class="hero-copy"><h1>Infrastructure,<br />understood by building.</h1><p class="lead">A collection of practical work in Linux, virtualisation, automation and observability. Each project records a problem, a decision and what the evidence showed.</p><div class="hero-actions"><a class="btn btn-primary" href="#projects">Explore the projects</a><a class="text-link" href="#observatory">Enter the Observatory</a></div></div>
    <div class="hero-art"><img src="/atlas.svg" alt="Illustration of infrastructure layers connected from services to computation" /><p>One lab, many interconnected decisions.</p></div>
  </section>
  <section class="intro section-wrap"><div><h2>Practice across the stack</h2><p class="lead">Virtual machines, services, monitoring and accelerated computing are connected by the same question: how does a system behave when something changes?</p></div><div class="skill-list"><h3>Working with</h3><p>{profile.data.skills.join(' / ')}</p><a href="/profile/">Read the professional summary</a></div></section>
  <section id="projects" class="section-wrap projects"><div class="section-heading"><h2>Selected projects</h2><p>Five documented decisions, their constraints and the lessons that followed.</p></div><div class="project-list">{cases.map(({ data }) => <a href={`/cases/${data.id}/`}><span><strong>{data.title}</strong><small>{data.technologies.join(' / ')}</small></span><span>{data.summary}</span><span aria-hidden="true">↗</span></a>)}</div></section>
  <Observatory cases={caseLinks} client:load />
</Layout>

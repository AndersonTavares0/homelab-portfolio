---
import Layout from '../layouts/Layout.astro';
import { loadContent, orderedCases } from '../../scripts/content.mjs';
import { phases } from '../model.js';
const { profile, cases } = loadContent();
const studies = orderedCases(cases).map(item => ({
  data: item.data,
  phase: phases.find(phase => phase.cases.includes(item.data.id))?.name ?? null
}));
---
<Layout title="Professional summary" description={`${profile.data.name}: documented infrastructure projects and the lessons behind them.`}><article class="reading section-wrap"><a class="back-link" href="/">← Home</a><h1>{profile.data.name}</h1><p class="lead">{profile.content.trim()}</p><p class="profile-contact"><a href={profile.data.github}>GitHub profile</a></p><h2>Technical areas</h2><p>{profile.data.skills.join(' / ')}</p><h2>Project experience</h2><p class="profile-order">Listed in the same thematic order as the case catalogue.</p>{studies.map(({data, phase}) => <section class="profile-case"><h3><a href={`/cases/${data.id}/`}>{data.title}</a></h3><p>{data.summary}</p><small>{data.technologies.join(' / ')}{phase ? ` · ${phase}` : ''}</small></section>)}<p>This summary is based on documented projects and is suitable for printing.</p></article></Layout>

<style>
  .profile-contact { margin-top: 1rem; }
  .profile-order { margin: 0 0 1.5rem; color: #4a6069; font-size: .9rem; }
</style>

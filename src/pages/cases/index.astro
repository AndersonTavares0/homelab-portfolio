---
import Layout from '../../layouts/Layout.astro';
import { loadContent } from '../../../scripts/content.mjs';
import { phases } from '../../model.js';
const { cases } = loadContent();
const items = cases.map(item => ({
  id: item.data.id,
  title: item.data.title,
  summary: item.data.summary,
  technologies: item.data.technologies,
  phase: phases.find(phase => phase.cases.includes(item.data.id))?.name ?? null
}));
---
<Layout title="Case studies" description="Five documented infrastructure studies: the problem, the decision, the evidence and what stayed unproven.">
  <article class="reading section-wrap case-index">
    <a class="back-link" href="/">← Home</a>
    <h1>Case studies</h1>
    <p class="lead">Five studies from one environment. Each records the problem, the decision, the observed result and the limit of what the evidence establishes.</p>
    <ol class="case-list">
      {items.map((item, index) => (
        <li>
          <a href={`/cases/${item.id}/`}>
            <span class="case-list__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="case-list__body">
              <strong>{item.title}</strong>
              <span class="case-list__summary">{item.summary}</span>
              <span class="case-list__meta">{item.technologies.join(' / ')}{item.phase ? ` · ${item.phase}` : ''}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
    <p><a href="/#observatory">Explore the same work in the Observatory</a></p>
  </article>
</Layout>

<style>
  .case-index .lead { margin-bottom: 2.5rem; }
  .case-list { list-style: none; margin: 0 0 2rem; padding: 0; border-top: 1px solid #aebec4; }
  .case-list li { border-bottom: 1px solid #cbd5d9; }
  .case-list a { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1.5rem; padding: 1.6rem 0; text-decoration: none; }
  .case-list__index { padding-top: .3rem; color: #4a6069; font-size: .8rem; font-variant-numeric: tabular-nums; }
  .case-list__body { display: grid; gap: .45rem; max-width: 62ch; }
  .case-list__body strong { font-size: 1.35rem; line-height: 1.25; }
  .case-list a:hover strong { text-decoration: underline; text-decoration-color: #2459b7; text-underline-offset: .22em; }
  .case-list__summary { color: #344850; line-height: 1.6; }
  .case-list__meta { color: #4a6069; font-size: .82rem; }
  @media (max-width: 700px) {
    .case-list a { grid-template-columns: 2.2rem 1fr; gap: 1rem; }
  }
</style>

---
import '../styles/global.css';
import { loadContent } from '../../scripts/content.mjs';
const { profile } = loadContent();
const summary = profile.content.trim().split(/(?<=[.!?])\s+/)[0];
const {
  title = 'Infrastructure in practice',
  description = summary,
  type = 'website'
} = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f4f6f5" />
  <meta name="color-scheme" content="light" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={profile.data.name} />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>{title} | {profile.data.name}</title>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header"><a class="wordmark" href="/">{profile.data.name}<span>.</span></a><nav aria-label="Main navigation"><a href="/#projects">Projects</a><a href="/#observatory">Observatory</a><a href="/profile/">Professional summary</a></nav></header>
  <main id="main" tabindex="-1"><slot /></main>
  <footer class="site-footer"><span>Built from documented work.</span><a href={profile.data.github}>GitHub profile</a><a href="#main">Back to top</a></footer>
</body>
</html>
